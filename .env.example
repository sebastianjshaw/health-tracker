# Local SQLite (default for development)
DATABASE_URL=file:local.db

# Turso only — required when DATABASE_URL is libsql://...
# DATABASE_AUTH_TOKEN=

# Single-user login password
APP_PASSWORD=changeme

# Signs the session cookie — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Google Health API integration (optional — Settings → Connections)
# OAuth Web client; register redirect URIs:
#   http://localhost:3000/api/integrations/google/callback  (dev)
#   https://<your-domain>/api/integrations/google/callback   (prod)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Shared secret for the daily Vercel cron (/api/cron/sync) — any long random string
# CRON_SECRET=
